# Optional. Orchestra runs with none of these set — the Settings screen collects
# whatever you want to use, and stores it in ~/.orchestra/config.json (mode 0600).
#
# Anything set here OVERRIDES the stored config and is never written to disk, which
# is the right choice for CI, containers, or a secrets manager.
#
# These are read from the process environment, not from this file. Export them
# yourself, or use `set -a; source .env; set +a` before ./run.sh

# Claude models.
ANTHROPIC_API_KEY=

# Local models. Only change this if Ollama is not on its default port.
OLLAMA_HOST=http://127.0.0.1:11434

# Any OpenAI-compatible endpoint: OpenRouter, LM Studio, vLLM, Groq, together.ai,
# OpenAI itself. Include the /v1 suffix if the service uses one.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Where per-user state lives. Handy for running a throwaway instance.
# ORCHESTRA_HOME=/tmp/orchestra-dev
